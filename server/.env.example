# docker 部署:复制到项目根目录为 .env(compose 自动读取:端口映射插值 + 整体注入容器)
# 本地直跑:复制到 server/.env 后用 dotenv 加载,或直接 export 到进程环境
# 说明:所有项都有默认值,不配也能跑(SQLite + 邮件验证码打到控制台)

# ---- 服务 ----
# 内外统一端口:容器内 nginx/后端同听此端口,compose 端口映射也用它
PORT=8787
# GM 后台路径(可自定义,须为独立子路径;不要带前导斜杠在 Git Bash 里会被转义)
GM_PATH=/gm
# ---- GM 管理员 ----
# 启动时自动创建/提升该道号为管理员(不存在则创建,已存在则提升)
GM_USER=
# GM 口令(6~64 字):给出时每次启动同步重置为该值;留空则保持已有口令不变
GM_PASS=
# JWT 密钥(≥16 字符);不配则自动生成并落盘 server/data/jwt-secret
# YUNYIN_JWT_SECRET=

# ---- 数据库 ----
# sqlite(默认) | mysql
DB_DRIVER=sqlite
# MySQL 时以下必填
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yunyin

# ---- 邮件 ----
# 以下只作首次建库种子值;运行期在 GM 后台「参数设置 → 邮件 / SMTP」页修改,改后立即生效
# true = 用 SMTP 实发验证码;false/未设 = 验证码打到控制台(响应带 devCode 供联调)
EMAIL_ENABLED=false
# true = 注册必须校验邮箱验证码(预留功能,默认关闭)
EMAIL_CODE_REQUIRED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
