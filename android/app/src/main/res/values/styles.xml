<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="colorAccent">@color/colorAccent</item>
    <item name="android:windowBackground">#0d1117</item>
    <item name="android:colorBackground">#0d1117</item>
  </style>

  <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:background">@null</item>
  </style>

  <!-- 启动主题(Android 11 及以下):不继承 Theme.SplashScreen;该库在 pre-31 缺
       windowSplashScreenBackground / windowSplashScreenAnimatedIcon(无 android: 前缀)时回退成「launcher 图标 + 白底」。
       windowBackground 与 activity_main 加载层同为 #0d1117 -->
  <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:windowBackground">#0d1117</item>
    <item name="android:colorBackground">#0d1117</item>
  </style>
</resources>